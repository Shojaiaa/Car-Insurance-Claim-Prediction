        "    fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
        "    for ax, metric in zip(axes, ['accuracy', 'loss']):\n",
        "        ax.plot(epochs, history.history[metric], label='Fitting')\n",
        "        ax.plot(epochs, history.history['val_' + metric], label='Validation')\n",
        "        ax.set(xlabel='Epoch', ylabel=metric.title(), title=f'{title}: {metric.title()}')\n",
        "        ax.legend()\n",
        "    fig.tight_layout()\n",
        "    plt.show()\n",
        "    best_epoch = int(np.argmax(history.history['val_accuracy'])) + 1\n",
        "    print(f'Completed epochs: {len(epochs)}; best validation-accuracy epoch: {best_epoch}; '\n",
        "          f'best validation accuracy: {max(history.history[\"val_accuracy\"]):.4f}')\n",
        "\n",
