        "## 5. Preprocessing and evaluation helpers\n",
        "Numerical values use median imputation and standard scaling. Ordinal variables retain\n",
        "their specified order; nominal variables use one-hot encoding. Missing categories use\n",
        "the most frequent training category. Every call builds a fresh preprocessor.\n",
        "\n",
        "Accuracy is reported together with positive-class precision, recall and F1. **False\n",
        "negatives (FN)** count missed actual claims; **FN rate** is FN divided by all actual\n",
        "claims, not by all customers. Model comparison uses validation F1, with recall and then\n",
        "accuracy as tie-breakers. This balances claim detection with false alarms. All\n",
        "probability predictions use a fixed threshold of 0.5; no financial cost saving is assumed.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "car-insurance-013",
      "metadata": {
        "id": "car-insurance-013"
      },
      "outputs": [],
      "source": [
        "ordinal_orders = {\n",
        "    'AGE': ['16-25', '26-39', '40-64', '65+'],\n",
        "    'DRIVING_EXPERIENCE': ['0-9y', '10-19y', '20-29y', '30y+'],\n",
        "    'EDUCATION': ['none', 'high school', 'university'],\n",
        "    'INCOME': ['poverty', 'working class', 'middle class', 'upper class'],\n",
        "    'VEHICLE_YEAR': ['before 2015', 'after 2015']\n",
        "}\n",
        "nominal_names = ['GENDER', 'RACE', 'POSTAL_CODE', 'VEHICLE_TYPE']\n",
        "\n",
        "def make_preprocessor(columns):\n",
        "    columns = list(columns)\n",
        "    ordinal = [c for c in columns if c in ordinal_orders]\n",
        "    nominal = [c for c in columns if c in nominal_names]\n",
        "    numeric = [c for c in columns if c not in ordinal + nominal]\n",
        "    transformers = []\n",
        "    if numeric:\n",
        "        transformers.append(('num', make_pipeline(\n",
        "            SimpleImputer(strategy='median', keep_empty_features=True), StandardScaler()\n",
        "        ), numeric))\n",
        "    if ordinal:\n",
        "        transformers.append(('ord', make_pipeline(\n",
        "            SimpleImputer(strategy='most_frequent', keep_empty_features=True),\n",
        "            OrdinalEncoder(categories=[ordinal_orders[c] for c in ordinal],\n",
        "                           handle_unknown='use_encoded_value', unknown_value=-1)\n",
        "        ), ordinal))\n",
        "    if nominal:\n",
        "        transformers.append(('nom', make_pipeline(\n",
        "            SimpleImputer(strategy='most_frequent', keep_empty_features=True),\n",
        "            OneHotEncoder(handle_unknown='ignore', sparse_output=False)\n",
        "        ), nominal))\n",
        "    return ColumnTransformer(transformers, remainder='drop', sparse_threshold=0)\n",
        "\n",
        "def metric_row(actual, predicted):\n",
        "    tn, fp, fn, tp = confusion_matrix(actual, predicted, labels=[0, 1]).ravel()\n",
        "    return {\n",
        "        'Accuracy': accuracy_score(actual, predicted),\n",
        "        'Claim Precision': precision_score(actual, predicted, zero_division=0),\n",
        "        'Claim Recall': recall_score(actual, predicted, zero_division=0),\n",
        "        'Claim F1': f1_score(actual, predicted, zero_division=0),\n",
        "        'TN': int(tn), 'FP': int(fp), 'FN': int(fn), 'TP': int(tp),\n",
        "        'FN Rate': fn / (fn + tp) if fn + tp else np.nan\n",
        "    }\n",
        "\n",
        "validation_rows = []\n",
        "candidates = {}\n",
        "\n",
        "def evaluate_candidate(name, model, train_features, val_features, kind='sklearn', preprocessor=None):\n",
        "    if kind == 'keras':\n",
        "        train_pred = (model.predict(train_features, verbose=0).ravel() >= THRESHOLD).astype(int)\n",
        "        val_pred = (model.predict(val_features, verbose=0).ravel() >= THRESHOLD).astype(int)\n",
        "    else:\n",
        "        train_pred = model.predict(train_features)\n",
        "        val_pred = model.predict(val_features)\n",
        "    row = {'Model': name, 'Train Accuracy': accuracy_score(y_train, train_pred),\n",
        "           **metric_row(y_val, val_pred)}\n",
        "    validation_rows.append(row)\n",
        "    candidates[name] = {'model': model, 'kind': kind, 'preprocessor': preprocessor}\n",
        "    print(name)\n",
        "    print(classification_report(y_val, val_pred, labels=[0, 1],\n",
        "                                target_names=['No Claim', 'Claim'], digits=4, zero_division=0))\n",
        "    display(pd.DataFrame([row]).set_index('Model').round(4))\n",
        "    ConfusionMatrixDisplay.from_predictions(y_val, val_pred, labels=[0, 1],\n",
        "                                            display_labels=['No Claim', 'Claim'])\n",
        "    plt.title(f'{name} — Validation')\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "    print(f'Missed {row[\"FN\"]} of {row[\"FN\"] + row[\"TP\"]} actual claims '\n",
        "          f'({row[\"FN Rate\"]:.2%}); false alarms: {row[\"FP\"]}.')\n",
        "    return row\n"
      ]
    },
