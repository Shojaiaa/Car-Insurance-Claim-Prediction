        "def forward_select_raw(features, target, n_features=10):\n",
        "    cv = StratifiedKFold(n_splits=3, shuffle=True, random_state=SEED)\n",
        "    selected = []\n",
        "    remaining = list(features.columns)\n",
        "    history_rows = []\n",
        "    for step in range(min(n_features, len(remaining))):\n",
        "        candidate_scores = []\n",
        "        for candidate in remaining:\n",
        "            subset = selected + [candidate]\n",
        "            pipeline = make_pipeline(\n",
        "                make_preprocessor(subset), DecisionTreeClassifier(random_state=SEED)\n",
        "            )\n",
        "            scores = cross_val_score(pipeline, features.loc[:, subset], target,\n",
        "                                     cv=cv, scoring='f1', n_jobs=1, error_score='raise')\n",
        "            candidate_scores.append((float(scores.mean()), candidate))\n",
        "        best_score, best_feature = max(candidate_scores, key=lambda item: item[0])\n",
        "        selected.append(best_feature)\n",
        "        remaining.remove(best_feature)\n",
        "        history_rows.append({'Step': step + 1, 'Added Feature': best_feature, 'CV Claim F1': best_score})\n",
        "        print(f'{step + 1:02d}: {best_feature} | CV claim F1 = {best_score:.4f}')\n",
        "    return selected, pd.DataFrame(history_rows)\n",
        "\n",
        "selected_features, selection_history = forward_select_raw(\n",
        "    X_train_engineered, y_train, N_SELECTED_FEATURES\n",
        ")\n",
        "display(selection_history)\n"
      ]
    },
